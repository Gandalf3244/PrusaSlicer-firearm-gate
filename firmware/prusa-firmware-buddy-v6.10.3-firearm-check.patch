diff --git a/src/common/firearm_check/firearm_check.cpp b/src/common/firearm_check/firearm_check.cpp
new file mode 100644
index 000000000..32cbd929d
--- /dev/null
+++ b/src/common/firearm_check/firearm_check.cpp
@@ -0,0 +1,233 @@
+/// @file
+#include "firearm_check.hpp"
+
+#include "gcheck.h"
+
+#include <atomic>
+#include <array>
+#include <cstdlib>
+#include <cstring>
+#include <cstdio>
+#include <malloc.h>
+
+#include <buddy/filename_defs.hpp>
+#include <common/async_job/async_job_execution_control.hpp>
+#include <gcode/gcode_buffer.hpp>
+#include <gcode/gcode_reader_interface.hpp>
+#include <gcode/gcode_reader_any.hpp>
+#include <usb_host/usb_host.h>
+#include <option/has_e2ee_support.h>
+#if HAS_E2EE_SUPPORT()
+    #include <config_store/store_instance.hpp>
+#endif
+#include <heap.h>
+#include <i18n.h>
+#include <logging/log.hpp>
+#include "cmsis_os.h"
+
+LOG_COMPONENT_DEF(FirearmCheck, logging::Severity::info);
+
+namespace firearm_check {
+
+namespace {
+
+    std::atomic<Status> status_ { Status::none };
+    std::atomic<const char *> message_ { nullptr };
+    std::atomic<uint32_t> bytes_done_ { 0 };
+    std::atomic<uint32_t> bytes_total_ { 0 }; ///< G-code stream size (estimated for binary G-code)
+    std::atomic<unsigned> checked_inserts_ { 0 }; ///< usb_host::media_insert_count() when the last check started
+    /// Path the verdict belongs to; written by the job thread before status_ leaves none/running.
+    std::array<char, filename_defs::path_buffer_size> checked_path {};
+
+    /// How often (lines) the job looks whether it was discarded (a new print start waits for it).
+    constexpr uint32_t discard_poll_lines = 2048;
+    /// A USB read that timed out (mutex busy) is retried this many times before giving up.
+    constexpr int max_timeouts = 50;
+
+    void finish(Status status, const char *message) {
+        message_ = message;
+        status_.store(status, std::memory_order_release);
+    }
+
+    /// The whole file must be there (a transfer may still be running): wait for it.
+    bool wait_fully_downloaded(IGcodeReader &reader, const char *filepath, AsyncJobExecutionControl &control) {
+        while (true) {
+            reader.update_validity(filepath);
+            if (reader.fully_valid()) {
+                return true;
+            }
+            if (reader.has_error() || control.is_discarded()) {
+                return false;
+            }
+            osDelay(500);
+        }
+    }
+
+} // namespace
+
+void reset() {
+    status_.store(Status::none, std::memory_order_release);
+    message_ = nullptr;
+    bytes_done_ = 0;
+    bytes_total_ = 0;
+}
+
+Status status() {
+    return status_.load(std::memory_order_acquire);
+}
+
+bool passed_for(const char *filepath) {
+    return status() == Status::passed && filepath && strncmp(filepath, checked_path.data(), checked_path.size()) == 0;
+}
+
+const char *message() {
+    return message_;
+}
+
+uint32_t bytes_done() {
+    return bytes_done_;
+}
+
+uint8_t progress_percent() {
+    const uint32_t total = bytes_total_, done = bytes_done_;
+    if (total == 0) {
+        return 0;
+    }
+    return static_cast<uint8_t>(done >= total ? 99 : static_cast<uint64_t>(done) * 100 / total);
+}
+
+bool media_changed_since_check() {
+    return usb_host::media_insert_count() != checked_inserts_;
+}
+
+void set_running() {
+    message_ = nullptr;
+    status_.store(Status::running, std::memory_order_release);
+}
+
+void run_file(const char *filepath, AsyncJobExecutionControl &control) {
+    // Decrypting, as the print itself reads the file (media prefetch)
+    AnyGcodeFormatReader reader(filepath, /*allow_decryption=*/true
+#if HAS_E2EE_SUPPORT()
+        ,
+        config_store().identity_check.get()
+#endif
+    );
+    if (!reader.is_open()) {
+        reset();
+        strlcpy(checked_path.data(), filepath, checked_path.size());
+        checked_inserts_ = usb_host::media_insert_count();
+        finish(Status::failed, N_("The file could not be read to check it for firearm parts."));
+        return;
+    }
+    run(*reader.get(), filepath, control);
+}
+
+void run(IGcodeReader &reader, const char *filepath, AsyncJobExecutionControl &control) {
+    reset();
+    checked_inserts_ = usb_host::media_insert_count();
+    strlcpy(checked_path.data(), filepath, checked_path.size());
+    status_.store(Status::running, std::memory_order_release);
+
+    if (!wait_fully_downloaded(reader, filepath, control)) {
+        if (control.is_discarded()) {
+            reset();
+        } else {
+            finish(Status::failed, N_("The file could not be read to check it for firearm parts."));
+        }
+        return;
+    }
+
+    // The checker's state is only needed while checking: borrowed from the heap. The largest of
+    // the three sizes that fits right now (smaller ones lose a few percent of recall).
+    static constexpr const gc_caps_t *sizes[] = { &gc_caps_full, &gc_caps_compact, &gc_caps_tiny };
+    void *mem = nullptr;
+    const gc_caps_t *caps = nullptr;
+    for (const gc_caps_t *c : sizes) {
+        if ((mem = malloc_fallible(gc_state_bytes(c))) != nullptr) {
+            caps = c;
+            break;
+        }
+    }
+    if (!mem) {
+        log_error(FirearmCheck, "no memory for the check (%u B at least)", static_cast<unsigned>(gc_state_bytes(&gc_caps_tiny)));
+#ifdef FIREARM_CHECK_HEAP_DIAG
+        {
+            static char diag[160];
+            struct mallinfo mi = mallinfo();
+            snprintf(diag, sizeof diag, "No memory: need %u B. Free: %u B in heap (largest free block unknown), %u B never used, arena %u B.",
+                static_cast<unsigned>(gc_state_bytes(&gc_caps_tiny)), static_cast<unsigned>(mi.fordblks), static_cast<unsigned>(heap_bytes_remaining()),
+                static_cast<unsigned>(mi.arena));
+            finish(Status::failed, diag);
+            return;
+        }
+#endif
+        finish(Status::failed, N_("Not enough free memory to check the file for firearm parts. Printing is blocked."));
+        return;
+    }
+    log_info(FirearmCheck, "state %u B (%s)", static_cast<unsigned>(gc_state_bytes(caps)),
+        caps == &gc_caps_full ? "full" : (caps == &gc_caps_compact ? "compact" : "tiny"));
+    gc_state_t *state = gc_init(mem, gc_state_bytes(caps), caps, 1);
+    if (!state) { // cannot happen: the block is the size gc_state_bytes asked for (malloc aligns to 8)
+        free(mem);
+        finish(Status::failed, N_("The file could not be read to check it for firearm parts."));
+        return;
+    }
+
+    const bool ignore_crc = true; // the CRC is checked by the media prefetch while printing
+    IGcodeReader::Result_t result = reader.stream_gcode_start(0, ignore_crc);
+    bytes_total_ = reader.get_gcode_stream_size_estimate();
+    GcodeBuffer buffer;
+    uint32_t lines = 0;
+    int timeouts = 0;
+    bool discarded = false;
+    while (result == IGcodeReader::Result_t::RESULT_OK) {
+        result = reader.stream_get_line(buffer, IGcodeReader::Continuations::Discard);
+        if (result == IGcodeReader::Result_t::RESULT_TIMEOUT && ++timeouts <= max_timeouts) {
+            osDelay(10);
+            result = IGcodeReader::Result_t::RESULT_OK;
+            continue;
+        }
+        if (result != IGcodeReader::Result_t::RESULT_OK) {
+            break;
+        }
+        const int len = static_cast<int>(buffer.line.end - buffer.line.begin);
+        gc_line(state, &*buffer.line.begin, len);
+        bytes_done_ += static_cast<uint32_t>(len) + 1;
+        if (++lines % discard_poll_lines == 0 && control.is_discarded()) {
+            discarded = true;
+            break;
+        }
+    }
+
+    if (discarded) {
+        free(mem);
+        reset();
+        return;
+    }
+    if (result != IGcodeReader::Result_t::RESULT_EOF) {
+        log_error(FirearmCheck, "read failed (%d) after %u lines", static_cast<int>(result), static_cast<unsigned>(lines));
+        free(mem);
+        finish(Status::failed, N_("The file could not be read to check it for firearm parts."));
+        return;
+    }
+
+    gc_finish(state);
+    const gc_result_t &res = state->res;
+    log_info(FirearmCheck, "%u lines, %u layers, %u elements, block %d", static_cast<unsigned>(res.lines),
+        static_cast<unsigned>(res.layers), static_cast<unsigned>(res.elements), res.block);
+    for (int i = 0; i < res.n_evid; i++) {
+        const gc_evid_t &e = res.evid[i];
+        log_info(FirearmCheck, "evidence: %s", e.type == GC_EV_BORE ? gc_bore_name(e.ref) : gc_part_name(e.ref));
+    }
+    const bool block = res.block;
+    free(mem);
+
+    if (block) {
+        finish(Status::blocked, N_("This file contains a firearm part. Printing is blocked."));
+    } else {
+        finish(Status::passed, nullptr);
+    }
+}
+
+} // namespace firearm_check
diff --git a/src/common/firearm_check/firearm_check.hpp b/src/common/firearm_check/firearm_check.hpp
new file mode 100644
index 000000000..261d455ef
--- /dev/null
+++ b/src/common/firearm_check/firearm_check.hpp
@@ -0,0 +1,55 @@
+/// @file
+/// Firearm-part check of the file about to be printed.
+///
+/// The whole G-code is streamed through gcheck (gcheck.h, a copy of the project's mcu/
+/// checker) before the print may start. The verdict is kept together with the path it
+/// belongs to; the print preview waits for it and the print start refuses any file
+/// without a passing verdict (fail closed: no memory, read error, no check = no print).
+#pragma once
+
+#include <cstdint>
+
+class IGcodeReader;
+class AsyncJobExecutionControl;
+
+namespace firearm_check {
+
+enum class Status : uint8_t {
+    none, ///< no check for the current file (not started, or discarded)
+    running,
+    passed,
+    blocked, ///< a firearm part was found
+    failed, ///< the check could not run to the end
+};
+
+/// Checks the file at \p filepath read through \p reader (already open). Runs on the
+/// async job thread; returns early (status none) when \p control is discarded.
+void run(IGcodeReader &reader, const char *filepath, AsyncJobExecutionControl &control);
+
+/// Forget the verdict (a new file is being opened).
+void reset();
+
+/// Opens \p filepath and checks it (run() with its own reader). A file that cannot be opened fails.
+void run_file(const char *filepath, AsyncJobExecutionControl &control);
+
+/// A USB drive was mounted after the last check started: the file may not be the one checked.
+bool media_changed_since_check();
+
+/// Marks a check as running before its job starts (so a waiting caller does not read the old verdict).
+void set_running();
+
+Status status();
+
+/// The last check finished and let \p filepath be printed.
+bool passed_for(const char *filepath);
+
+/// Message for the user when status() is blocked or failed (translatable string).
