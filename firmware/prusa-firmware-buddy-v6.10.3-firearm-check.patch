+/// The file error screen, with the firearm check's own reason when the check refused the file
+/// (the stock screen shows only the generic error text).
+class FrameFileError {
+public:
+    FrameFileError(window_frame_t *parent)
+        : prompt(make(parent)) {}
+
+private:
+    static FramePrompt make(window_frame_t *parent) {
+        const char *msg = firearm_check::message();
+        const auto st = firearm_check::status();
+        if (msg && (st == firearm_check::Status::blocked || st == firearm_check::Status::failed)) {
+            return FramePrompt(parent, Phase::file_error, _("Print blocked"), _(msg));
+        }
+        return FramePrompt(parent, Phase::file_error, map_print_preview_phase_to_error_code);
+    }
+    FramePrompt prompt;
+};
